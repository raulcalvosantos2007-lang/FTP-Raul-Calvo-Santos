options {
    directory "/var/cache/bind";

    // Escucha solo en IPv4: loopback y la interfaz de la red privada.
    listen-on { 127.0.0.1; 192.168.57.5; };
    listen-on-v6 { none; };

    // Recursión únicamente para el propio servidor y la red privada.
    recursion yes;
    allow-recursion { localhost; 192.168.57.0/24; };

    // No permitir transferencias de zona desde otros equipos.
    allow-transfer { none; };

    dnssec-validation auto;
};
